{
"manifest_version": 3,
"name": "JobTrack-AI Application Tracker",
"version": "1.0.0",
"description": "Detect job application activity and send jobs to JobTrack-AI for review.",
"permissions": [
"storage",
"activeTab"
],
"host_permissions": [
"https://www.linkedin.com/*",
"https://linkedin.com/*",
"https://www.indeed.com/*",
"https://indeed.com/*",
"http://127.0.0.1:8000/*",
"http://localhost:8000/*",
"https://jobtrack-ai-1-a4ie.onrender.com/*"
],
"background": {
"service_worker": "background.js"
},
"action": {
"default_title": "JobTrack-AI",
"default_popup": "popup.html"
},
"content_scripts": [
{
"matches": [
"https://www.linkedin.com/jobs/*",
"https://linkedin.com/jobs/*",
"https://www.indeed.com/*",
"https://indeed.com/*"
],
"js": [
"content.js"
],
"run_at": "document_idle"
}
]
}
